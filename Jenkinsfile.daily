def customers = [
  'piedmont': [
    url: 'https://piedmont.nimblethis.net/',
    tag: '@customer_piedmont'
  ],
  'zito': [
    url: 'https://nimble-web.zitomedia.net/',
    tag: '@customer_zito'
  ],
  'brctv': [
    url: 'https://brctv.pnm.openvault.net/',
    tag: '@customer_brctv'
  ],
  'comporium': [
    url: 'https://comporiumv5.nimblethis.net/',
    tag: '@customer_comporium'
  ],
  'sectv': [
    url: 'http://sectv.vantage.openvault.net/',
    tag: '@customer_sectv'
  ],
  'secv': [
    url: 'https://secv.pnm.openvault.net/',
    tag: '@customer_secv'
  ],
  'wow-trial': [
    url: 'https://wow-vantage-trial.openvault.net/',
    tag: '@customer_wow_trial'
  ]
]

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  triggers {
    cron('H 6 * * *')
  }

  parameters {
    string(
      name: 'SINGLE_CUSTOMER_JOB',
      defaultValue: 'qa-vpn-sanity-poc',
      description: 'Existing Jenkins job that uses jenkins-vpn-qa-poc/Jenkinsfile.'
    )
    choice(
      name: 'BROWSER',
      choices: ['chrome', 'chromium', 'firefox'],
      description: 'Browser requested by the QA automation.'
    )
    string(
      name: 'RUN_AGENT_LABEL',
      defaultValue: 'customer-piedmont',
      description: 'Jenkins node label passed to each customer job. Use customer-piedmont to test all customers from the Piedmont agent.'
    )
    string(
      name: 'APP_USERNAME',
      defaultValue: 'rabil.khanna@openvault.com',
      description: 'Application username passed to customer jobs for parameterized login-smoke tests.'
    )
    string(
      name: 'BASE_TAGS',
      defaultValue: '@synthetic_monitoring',
      description: 'Base Behave tag expression combined with each customer tag.'
    )
    text(
      name: 'QA_TEST_COMMAND',
      defaultValue: '''behave features/ui_synthetic_monitoring.feature --tags "${TEST_TAGS}" -D browser="${BROWSER}" -D endpoint="${TARGET_URL}" --format plain --no-source --no-capture --no-skipped --logging-level ERROR --junit --junit-directory artifacts/test-results''',
      description: 'Command passed to each customer job and executed inside that customer agent container.'
    )
    string(
      name: 'QA_PASSWORD_FERNET_CREDENTIALS_ID',
      defaultValue: '',
      description: 'Optional Jenkins Secret text credential ID containing the Fernet key used by each customer job.'
    )
    string(
      name: 'APP_PASSWORD_CREDENTIALS_ID',
      defaultValue: 'rabil-password',
      description: 'Jenkins Secret text credential ID containing the plain application password used by each customer job.'
    )
  }

  stages {
    stage('Trigger Customer Sanity Jobs') {
      steps {
        script {
          def branches = [:]

          customers.each { customerKey, cfg ->
            branches[customerKey] = {
              def tagExpression = "${params.BASE_TAGS} and ${cfg.tag}"
              echo "Triggering ${params.SINGLE_CUSTOMER_JOB} for ${customerKey} with ${tagExpression}"
              build job: params.SINGLE_CUSTOMER_JOB,
                wait: true,
                propagate: true,
                parameters: [
                  string(name: 'CUSTOMER', value: customerKey),
                  string(name: 'RUN_AGENT_LABEL', value: params.RUN_AGENT_LABEL),
                  string(name: 'ENVIRONMENT_URL', value: cfg.url),
                  string(name: 'BROWSER', value: params.BROWSER),
                  string(name: 'APP_USERNAME', value: params.APP_USERNAME),
                  string(name: 'TEST_TAGS', value: tagExpression),
                  text(name: 'QA_TEST_COMMAND', value: params.QA_TEST_COMMAND),
                  string(name: 'QA_PASSWORD_FERNET_CREDENTIALS_ID', value: params.QA_PASSWORD_FERNET_CREDENTIALS_ID),
                  string(name: 'APP_PASSWORD_CREDENTIALS_ID', value: params.APP_PASSWORD_CREDENTIALS_ID)
                ]
            }
          }

          parallel branches
        }
      }
    }
  }
}
