# Jenkins controller URL reachable from the customer/client server.
JENKINS_URL=https://jenkins.example.com/

# Jenkins inbound agent values from Manage Jenkins > Nodes > selected node.
JENKINS_AGENT_NAME=qa-agent-piedmont
JENKINS_SECRET=replace-with-jenkins-agent-secret

# Customer key used for local identification and logs.
CUSTOMER_KEY=piedmont

# Default browser requested by the QA script.
BROWSER=chrome

# Use host networking for this POC so the container uses the client server's
# existing VPN/private routes and does not require nerdctl bridge CNI plugins.
NERDCTL_NETWORK_MODE=host

# Optional: host directory containing decryption config/keys needed by the QA
# framework for encrypted passwords. The directory is mounted read-only into the
# container at QA_SECRET_DIR.
# QA_SECRET_DIR_HOST=/secure/path/customer-qa-secrets
# QA_SECRET_DIR=/home/jenkins/qa-secrets
