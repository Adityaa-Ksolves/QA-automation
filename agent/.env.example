# Jenkins controller URL reachable from the customer/client server.
JENKINS_URL=https://jenkins.example.com/

# Jenkins inbound agent values from Manage Jenkins > Nodes > selected node.
JENKINS_AGENT_NAME=qa-agent-piedmont
JENKINS_SECRET=replace-with-jenkins-agent-secret

# Customer key used for local identification and logs.
CUSTOMER_KEY=piedmont

# Default browser requested by the QA script.
BROWSER=chrome
